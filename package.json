{
  "name": "beacon-attestation",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "contract:test": "node scripts/run-python.mjs -m pytest contract/tests -q",
    "contract:mutation": "node scripts/run-python.mjs contract/tests/mutation/run.py",
    "check:protocol": "node scripts/audit-protocol.mjs",
    "check": "npm run check:protocol && npm run contract:test && npm run contract:mutation && npm run frontend:build && npm run frontend:test",
    "evidence": "node scripts/reviewer-evidence.mjs",
    "evidence:live": "node scripts/verify-studionet.mjs",
    "evidence:frontend": "node scripts/verify-production.mjs",
    "evidence:public": "node scripts/verify-public-repo.mjs"
  }
}
