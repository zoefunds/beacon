{
  "name": "beacon-attestation",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "contract:test": "(.venv/bin/python -m pytest contract/tests -q 2>/dev/null || python3 -m pytest contract/tests -q)",
    "contract:mutation": "(.venv/bin/python contract/tests/mutation/run.py 2>/dev/null || python3 contract/tests/mutation/run.py)",
    "check:protocol": "node scripts/audit-protocol.mjs",
    "check": "npm run check:protocol && npm run contract:test && npm run contract:mutation && npm run frontend:build && npm run frontend:test"
  }
}
